# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# Password for the local Docker Postgres container.
# docker-compose.yml defaults to 'retailmind_dev' if this var is unset,
# but setting it here keeps all connection details in one place.
POSTGRES_PASSWORD=retailmind_dev

# Full connection string used by the backend.
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
# Local dev (Docker):  point at localhost:5432
# Prod (Supabase):     replace with the Supabase pooler URL from the dashboard
DATABASE_URL=postgresql://postgres:retailmind_dev@localhost:5432/retailmind

# LLM provider: "ollama" for local dev, "hosted" for production
LLM_PROVIDER=ollama

# Ollama connection (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
