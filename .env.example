# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# Password for the local Docker Postgres container.
# docker-compose.yml defaults to 'retailmind_dev' if this var is unset,
# but setting it here keeps all connection details in one place.
POSTGRES_PASSWORD=retailmind_dev

# Full connection string used by the backend (admin / dev context).
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
# Local dev (Docker):  point at localhost:5432
# Prod (Supabase):     replace with the Supabase pooler URL from the dashboard
DATABASE_URL=postgresql://postgres:retailmind_dev@localhost:5432/retailmind

# Read-only connection used exclusively by the analytics agent at runtime.
# Must connect as analytics_reader — SELECT on retail schema only.
# Never use DATABASE_URL (postgres superuser) for generated SQL execution.
ANALYTICS_DATABASE_URL=postgresql://analytics_reader:change_me@localhost:5432/retailmind

# LLM provider: "ollama" for local dev, "hosted" for production
LLM_PROVIDER=ollama

# Ollama connection (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Document agent — vector store, embeddings, and uploads
# CHROMA_PATH: local directory for ChromaDB persistence (relative to repo root)
CHROMA_PATH=data/chroma
# EMBEDDING_MODEL: sentence-transformers model name; all-MiniLM-L6-v2 is 23MB and runs on CPU
EMBEDDING_MODEL=all-MiniLM-L6-v2
# DOCUMENT_TOP_K: number of chunks retrieved per query
DOCUMENT_TOP_K=5
# UPLOADS_PATH: directory where uploaded PDFs are saved (relative to repo root)
UPLOADS_PATH=data/uploads
